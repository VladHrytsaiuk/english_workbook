{
  "name": "english-workbook",
  "productName": "EnglishWorkbook",
  "version": "1.10.1",
  "description": "A personal English workbook: Markdown notes, tests, translation and progress stats.",
  "main": "./out/main/index.js",
  "author": "Vlad",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run typecheck && npm run test && electron-vite build && electron-builder --mac dmg",
    "icon": "env -u ELECTRON_RUN_AS_NODE electron scripts/icon/main.cjs",
    "smoke": "electron-vite build && node scripts/smoke.mjs .smoke/shots",
    "dist:win": "npm run typecheck && npm run test && electron-vite build && electron-builder --win",
    "release:publish": "node scripts/publish-release.mjs",
    "dist:all": "npm run typecheck && npm run test && electron-vite build && electron-builder --mac dmg --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.11",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.5.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.68.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "3.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VladHrytsaiuk/english_workbook.git"
  }
}
